# Cloudinary Configuration
# Get these from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Convex Configuration (Vunarc — curious-gerbil-938)
CONVEX_DEPLOYMENT=dev:curious-gerbil-938
NEXT_PUBLIC_CONVEX_URL=https://curious-gerbil-938.convex.cloud

# App Configuration
NEXT_PUBLIC_APP_NAME=Vunarc
NEXT_PUBLIC_APP_DESCRIPTION=Harvesting the future through sustainable agriculture

# Arc mainnet. Gas and order payments are native USDC (18 decimals).
ARC_PRIVATE_KEY=your_wallet_private_key_for_deployment
NEXT_PUBLIC_ARC_CONTRACT_ADDRESS=0x47849a11c7a3ad9da16d5736cdacaa91c7ee8e63

# Payment Authorization Secret (for frontend authorization)
NEXT_PUBLIC_PAYMENT_SECRET=your_secure_payment_secret_here

# WalletConnect Project ID — https://cloud.walletconnect.com (MetaMask works without this)
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_wallet_connect_project_id

# Fee Recipient Address (where platform fees are sent)
FEE_RECIPIENT_ADDRESS=0x_your_fee_recipient_wallet_address
NEXT_PUBLIC_PLATFORM_ARC_ADDRESS=0x_your_platform_arc_wallet_address

# App URL (for wallet metadata)
NEXT_PUBLIC_URL=http://localhost:3000

# Divvi Referral Tracking (optional)
NEXT_PUBLIC_DIVVI_CONSUMER_ADDRESS=0x_your_divvi_consumer_address
 